<Window x:Class="UZConnect.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
        Title="UZConnect Connection Manager"
        Width="1120" Height="740" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/UZConnect;component/Assets/uzconnect.ico"
        Background="{StaticResource WindowBack}"
        FontFamily="{StaticResource ClassicFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C23B32" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Root" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="White"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1B2A55" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Classic title bar -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/app-icon.png" Width="18" Height="18" Margin="5,0,6,0"
                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="UZConnect Connection Manager" Style="{StaticResource TitleText}"
                               Margin="0,0,0,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource TitleButton}"
                                ToolTip="Minimize" Click="MinimizeButton_Click">
                            <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/title-min.png"
                                   Width="9" Height="9" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}"
                                ToolTip="Maximize" Click="MaximizeButton_Click" Margin="2,0,0,0">
                            <Image x:Name="MaximizeIcon"
                                   Source="pack://application:,,,/UZConnect;component/Assets/icons/title-max.png"
                                   Width="9" Height="9" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseTitleButton}"
                                ToolTip="Close" Click="CloseButton_Click" Margin="2,0,0,0">
                            <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/tb-close.png"
                                   Width="9" Height="9" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Classic icon toolbar -->
            <Border Grid.Row="1" Background="{StaticResource ToolbarBrush}">
                <Grid>
                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="26,2,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ToolbarItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <Image Source="{Binding IconPath}" Width="52" Height="52"
                                       ToolTip="{Binding Label}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Height="1" VerticalAlignment="Bottom" Background="#66FFFFFF" />
                </Grid>
            </Border>

            <!-- Page content -->
            <Border Grid.Row="2" Background="{StaticResource ContentBrush}">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>

            <!-- Classic status bar -->
            <Border Grid.Row="3" Background="{StaticResource StatusBack}"
                    BorderBrush="{StaticResource StatusBorder}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8,0">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/status-device.png"
                               Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusDeviceText}" Style="{StaticResource StatusText}" Margin="5,0,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource StatusBorder}" Margin="0,4" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/status-signal.png"
                               Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusSignalText}" Style="{StaticResource StatusText}" Margin="5,0,0,0" />
                        <TextBlock Text="  |  " Style="{StaticResource StatusText}" Foreground="#8A96A5" />
                        <TextBlock Text="{Binding StatusConnectionText}" Style="{StaticResource StatusText}" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="{StaticResource StatusBorder}" Margin="0,4" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/status-sms.png"
                               Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusSmsText}" Style="{StaticResource StatusText}" Margin="5,0,8,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>


