<UserControl x:Class="UZConnect.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:HelpViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#315E96" BorderBrush="#1F4E9A" BorderThickness="0,0,0,1">
            <TextBlock Text="Help" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                       Margin="8,0" />
        </Border>
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="18,16">
                <TextBlock Text="UZConnect Connection Manager" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}" FontSize="11" Margin="0,3,0,0" />
                <Border Height="1" Background="#B4C0CE" Margin="0,12" />
                <TextBlock Text="Device" FontWeight="Bold" FontSize="11" />
                <TextBlock Text="{Binding DeviceModel, StringFormat=Model: {0}}" FontSize="11" Margin="0,3,0,0" />
                <TextBlock Text="{Binding Firmware, StringFormat=Firmware: {0}}" FontSize="11" Margin="0,2,0,0" />
                <Border Height="1" Background="#B4C0CE" Margin="0,12" />
                <TextBlock Text="User manual" FontWeight="Bold" FontSize="11" />
                <TextBlock Text="Open the D-Link DWM-222 user manual for connection, SMS, contacts, USSD and settings help."
                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                <Button Style="{StaticResource ClassicButton}" Content="Open user manual" Width="130"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenManualCommand}" />
                <Border Height="1" Background="#B4C0CE" Margin="0,14" />
                <TextBlock Text="Wi-Fi Management is an additional UZConnect section. All other screens follow the classic connection manager layout."
                           FontSize="10" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="560"
                           HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
