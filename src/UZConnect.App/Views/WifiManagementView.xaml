<UserControl x:Class="UZConnect.App.Views.WifiManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             FontSize="11">
    <UserControl.Resources>
        <SolidColorBrush x:Key="RouterInk" Color="#333333" />
        <SolidColorBrush x:Key="RouterLine" Color="#C6D4E3" />
        <SolidColorBrush x:Key="RouterSoft" Color="#DCE6F1" />
        <SolidColorBrush x:Key="RouterAccent" Color="#1F5FA9" />
        <SolidColorBrush x:Key="RouterMuted" Color="#6B7B8C" />

        <Style x:Key="RouterLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{StaticResource RouterInk}" />
        </Style>

        <Style x:Key="RouterRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource RouterSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#FDFEFF" />
        </Style>

        <Style x:Key="RouterSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RouterAccent}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="RouterRule" TargetType="Border">
            <Setter Property="BorderBrush" Value="#9DB9D6" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Margin" Value="0,3,0,2" />
        </Style>

        <Style x:Key="ReadOnlyBox" TargetType="TextBox">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#C3D2E1" />
            <Setter Property="Background" Value="#F7FAFD" />
            <Setter Property="Foreground" Value="{StaticResource RouterInk}" />
        </Style>

        <Style x:Key="RouterButton" TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="3" BorderBrush="#1D5C9E" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4E92D2" Offset="0" />
                                    <GradientStop Color="#2E75B6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#8CBDEE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RouterGreenButton" TargetType="Button" BasedOn="{StaticResource RouterButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="3" BorderBrush="#3C7A22" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6DB33F" Offset="0" />
                                    <GradientStop Color="#4C9A2A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#9BD37A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RouterNav" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Face" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="3,0,0,0" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#E4EEF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#CFE2F3" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="#2E75B6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableHeader" TargetType="Border">
            <Setter Property="Background" Value="#EAF1F8" />
            <Setter Property="BorderBrush" Value="{StaticResource RouterLine}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Padding" Value="5,4" />
        </Style>

        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource RouterLine}" />
            <Setter Property="BorderThickness" Value="1,0,1,0" />
            <Setter Property="Padding" Value="5,4" />
        </Style>

        <Style x:Key="TableHeadText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#33506B" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="TableText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RouterInk}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PageHeader" TargetType="TextBlock" BasedOn="{StaticResource RouterSection}">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Router-style blue header -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2E7BC4" Offset="0" />
                    <GradientStop Color="#1B5FA8" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="UZConnect" FontSize="16" FontWeight="Bold" Foreground="White" FontStyle="Italic" />
                    <Border Width="1" Height="16" Background="#66FFFFFF" Margin="10,0" />
                    <TextBlock Text="Wi-Fi Information" FontSize="12" Foreground="#EAF3FB" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Foreground="#D8E8F8" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource RouterGreenButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Router-style section tree -->
            <Border Background="#EDEDED" BorderBrush="#C9C9C9" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Information" FontWeight="Bold" FontSize="12"
                               Foreground="#4A4A4A" Margin="10,10,0,6" />
                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource RouterNav}" Background="Transparent"
                             BorderThickness="0" Padding="0,0,0,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WifiNavItem}">
                                <Border x:Name="Bar" Background="Transparent" Padding="9,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Glyph" Text="▸" FontSize="9" Foreground="#4A6B8A"
                                                   Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Caption" Text="{Binding Label}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter TargetName="Bar" Property="Background" Value="#D9D9D9" />
                                        <Setter TargetName="Bar" Property="Padding" Value="7,3" />
                                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Caption" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="Caption" Property="Foreground" Value="#4A4A4A" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="12,10,14,18">

                    <!-- Status -->
                    <StackPanel Visibility="{Binding SelectedPageKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Status}">
                        <TextBlock Text="Status" Style="{StaticResource PageHeader}" />
                        <Border Style="{StaticResource RouterRule}" />

                        <Border Style="{StaticResource RouterRow}" Margin="0,8,0,0" Padding="8,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Wi-Fi :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Wireless" Style="{StaticResource RouterSection}" Margin="0,14,0,2" />
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Wireless Status :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="Bold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Network Name (SSID) :" Style="{StaticResource RouterLabel}" />
                                <TextBox Grid.Column="1" Style="{StaticResource ReadOnlyBox}" Width="240" HorizontalAlignment="Left"
                                         IsReadOnly="True" Text="{Binding Ssid, Mode=OneWay}"
                                         AutomationProperties.Name="Wireless network name" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Password :" Style="{StaticResource RouterLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Style="{StaticResource ReadOnlyBox}" Width="240" HorizontalAlignment="Left"
                                             IsReadOnly="True" Text="{Binding Password, Mode=OneWay}"
                                             AutomationProperties.Name="Wi-Fi password" />
                                    <TextBlock Text="{Binding PasswordStatus}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource RouterMuted}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Authentication Type :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding AuthenticationType}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Encryption Type :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding EncryptionType}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Channel :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Channel}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="SSID Broadcast :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Broadcast}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Connected Devices :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding ConnectedCount}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="LAN" Style="{StaticResource RouterSection}" Margin="0,14,0,2" />
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="IP Address :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding LanAddress}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="DHCP Server :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DhcpStatus}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Address Range :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TableText}">
                                    <Run Text="{Binding DhcpStart, Mode=OneWay}" /><Run Text="  –  " /><Run Text="{Binding DhcpEnd, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ReadOnlyNote}" Foreground="{StaticResource RouterMuted}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding LastUpdated}" Foreground="{StaticResource RouterMuted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Wireless Client List -->
                    <StackPanel Visibility="{Binding SelectedPageKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=ClientList}">
                        <TextBlock Text="Wireless Client List" Style="{StaticResource PageHeader}" />
                        <Border Style="{StaticResource RouterRule}" />
                        <TextBlock Text="{Binding ClientSummary}" Foreground="{StaticResource RouterMuted}" Margin="0,8,0,6" />
                        <Border Style="{StaticResource TableHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" /><ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ID" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="1" Text="Device Name" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="2" Text="IP Address" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="3" Text="MAC Address" Style="{StaticResource TableHeadText}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ClientRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WifiClientRow}">
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" /><ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding IpAddress}" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="3" Text="{Binding MacAddress}" Style="{StaticResource TableText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource TableRow}" BorderThickness="1,0,1,1"
                                Visibility="{Binding HasClientRows, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="No connected Wi-Fi devices are reported." Foreground="{StaticResource RouterMuted}" />
                        </Border>
                        <TextBlock Text="Only devices associated with the modem's Wi-Fi are listed. A device may not yet hold an IP address. Select Refresh to update."
                                   Foreground="{StaticResource RouterMuted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   MaxWidth="640" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding LastUpdated}" Foreground="{StaticResource RouterMuted}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- LAN / DHCP -->
                    <StackPanel Visibility="{Binding SelectedPageKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Lan}">
                        <TextBlock Text="LAN IP Setup" Style="{StaticResource PageHeader}" />
                        <Border Style="{StaticResource RouterRule}" />
                        <Border Style="{StaticResource RouterRow}" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="IP Address :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding LanAddress}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="DHCP Server" Style="{StaticResource RouterSection}" Margin="0,14,0,2" />
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="DHCP Server Status :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DhcpStatus}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Start IP Address :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DhcpStart}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="End IP Address :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DhcpEnd}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RouterRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Address Lease Time :" Style="{StaticResource RouterLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DhcpLease}" Style="{StaticResource TableText}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="DHCP Client List" Style="{StaticResource RouterSection}" Margin="0,14,0,2" />
                        <Border Style="{StaticResource TableHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" /><ColumnDefinition Width="150" /><ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ID" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="1" Text="IP Address" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="2" Text="MAC Address" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="3" Text="Host Name" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="4" Text="Reserved" Style="{StaticResource TableHeadText}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ClientRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WifiClientRow}">
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" /><ColumnDefinition Width="150" /><ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding MacAddress}" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Name}" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="4" Text="Dynamic" Style="{StaticResource TableText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource TableRow}" BorderThickness="1,0,1,1"
                                Visibility="{Binding HasClientRows, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="No DHCP clients are currently reported." Foreground="{StaticResource RouterMuted}" />
                        </Border>
                        <TextBlock Text="The running address server also serves USB tethering, so these entries are not all Wi-Fi devices."
                                   Foreground="{StaticResource RouterMuted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   MaxWidth="640" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ReadOnlyNote}" Foreground="{StaticResource RouterMuted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Feature Availability -->
                    <StackPanel Visibility="{Binding SelectedPageKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Availability}">
                        <TextBlock Text="Feature Availability" Style="{StaticResource PageHeader}" />
                        <Border Style="{StaticResource RouterRule}" />
                        <Border Style="{StaticResource TableHeader}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="ID" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="1" Text="Feature" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource TableHeadText}" />
                                <TextBlock Grid.Column="3" Text="Detail" Style="{StaticResource TableHeadText}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding FeatureRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WifiFeatureRow}">
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" /><ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TableText}" FontWeight="Bold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource TableText}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Reason}" Style="{StaticResource TableText}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ReadOnlyNote}" Foreground="{StaticResource RouterMuted}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#EAF1F8" BorderBrush="#C6D4E3" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Text="{Binding Feedback}" Foreground="{StaticResource RouterMuted}" />
        </Border>
    </Grid>
</UserControl>
