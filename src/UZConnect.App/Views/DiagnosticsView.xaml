<UserControl x:Class="UZConnect.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}"
             mc:Ignorable="d">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Copy summary"
                                Command="{Binding CopySummaryCommand}" Margin="0,0,8,0" Padding="12,7" FontSize="11" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Export report"
                                Command="{Binding ExportCommand}" Margin="0,0,8,0" Padding="12,7" FontSize="11" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Refresh"
                                Command="{Binding RefreshCommand}" Padding="12,7" FontSize="11" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Transport" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding Provider}" Style="{StaticResource CardValue}" Margin="0,6,0,0"
                                       FontSize="17" />
                            <TextBlock Text="{Binding AdbState}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="ADB found" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding AdbFound, Converter={StaticResource BoolToText}, ConverterParameter='Yes|No'}"
                                       Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding AdbPath}" Style="{StaticResource MonoText}" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="Device" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding Model}" Style="{StaticResource CardValue}" Margin="0,6,0,0"
                                       FontSize="17" />
                            <TextBlock Text="{Binding Firmware}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="Hardware" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding Hardware}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Serial, StringFormat=Serial: {0}}" Style="{StaticResource MonoText}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Grid.Column="4">
                        <StackPanel>
                            <TextBlock Text="Last successful communication" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding LastCommunication}" Style="{StaticResource BodyText}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="COM ports" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding ComPortsText}" Style="{StaticResource MonoText}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UsbCountText}" Style="{StaticResource SubtleCaption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="USB devices and interfaces" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Fresh Windows PnP enumeration. No VID/PID is hard-coded."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        <ItemsControl ItemsSource="{Binding UsbDevices}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UsbDeviceRow}">
                                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Identity}" Style="{StaticResource MonoText}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource Badge}"
                                                        Background="{DynamicResource SuccessSoft}"
                                                        Visibility="{Binding HasAdb, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ADB" Style="{StaticResource PillText}"
                                                               Foreground="{DynamicResource Success}" />
                                                </Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Interfaces}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:InterfaceRow}">
                                                        <Border Background="{DynamicResource Surface}"
                                                                BorderBrush="{DynamicResource Border}"
                                                                BorderThickness="1" CornerRadius="7" Padding="8,4"
                                                                Margin="0,0,5,5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Role}" FontSize="9.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Accent}" />
                                                                <TextBlock Text="{Binding ComPort}" FontSize="9.5"
                                                                           Margin="5,0,0,0"
                                                                           Foreground="{DynamicResource TextTertiary}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Serial / AT probe" Style="{StaticResource SectionTitle}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Probe ports"
                                        Command="{Binding RequestProbeCommand}" HorizontalAlignment="Right"
                                        Padding="10,5" FontSize="11" />
                            </Grid>
                            <TextBlock Text="{Binding ProbeSummary}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding AtProbes}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MonoText}"
                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="Read-only command" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Allow-listed getprop, dumpsys, settings get, content query, ls and cat /proc commands."
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBox Style="{StaticResource TextBoxBase}" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,10,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Run"
                                        Command="{Binding RunCommandCommand}" Padding="12,6" FontSize="11" />
                                <Button Style="{StaticResource GhostButton}" Content="Clear"
                                        Command="{Binding ClearCommandCommand}" Padding="10,6" FontSize="11"
                                        Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBox Style="{StaticResource MultilineTextBox}" Height="130" Margin="0,10,0,0"
                                     IsReadOnly="True" Text="{Binding CommandOutput, Mode=OneWay}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     Visibility="{Binding HasCommandOutput, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Diagnostics log" Style="{StaticResource SectionTitle}" />
                            <Button Style="{StaticResource GhostButton}" Content="Open exports folder"
                                    Command="{Binding OpenFolderCommand}" HorizontalAlignment="Right"
                                    Padding="10,5" FontSize="11" />
                        </Grid>
                        <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding LogEntries}"
                                 Height="320" Margin="0,10,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeDisplay}" Style="{StaticResource MonoText}"
                                                   FontSize="10" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding LevelLabel}" FontSize="9.5"
                                                   FontWeight="Bold" VerticalAlignment="Top"
                                                   Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="10"
                                                   VerticalAlignment="Top" Foreground="{DynamicResource TextTertiary}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Text="{Binding LogPath}" Style="{StaticResource MonoText}"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding DataFolder, StringFormat=Data directory: {0}}"
                           Style="{StaticResource SubtleCaption}" Margin="2,10,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </ScrollViewer>

        <!-- AT probe confirmation -->
        <Grid Background="{DynamicResource Scrim}"
              Visibility="{Binding ShowProbePrompt, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="470" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Probe serial ports?" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="This opens every COM port briefly at 115200 and 9600 baud and sends the read-only AT command. It can fail if another program owns a port. It does not change modem state." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                                Command="{Binding CancelProbeCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Probe"
                                Command="{Binding ConfirmProbeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
