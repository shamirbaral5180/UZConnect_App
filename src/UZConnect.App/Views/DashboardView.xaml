<UserControl x:Class="UZConnect.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d">
    <Grid Background="{StaticResource ContentBrush}" ClipToBounds="True">
        <!-- Faint globe watermark, matching the reference background. -->
        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/connection-watermark.png" Width="460" Height="460"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-140,0,0,-170"
               Stretch="Uniform" Opacity="0.7" IsHitTestVisible="False" />
        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/connection-watermark.png" Width="420" Height="420"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-120,0"
               Stretch="Uniform" Opacity="0.55" IsHitTestVisible="False" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,0">
            <Button Style="{StaticResource ConnectButton}" Command="{Binding ConnectCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/connect-icon.png" Width="24" Height="24" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ConnectButtonText}" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding ConnectionActionStatus}" HorizontalAlignment="Center" FontSize="10"
                       Foreground="{StaticResource MutedText}" Margin="0,10,0,0" MaxWidth="320"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ConnectionStatusText, StringFormat=Status: {0}}" HorizontalAlignment="Center"
                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding IpText, StringFormat=IP address: {0}}" HorizontalAlignment="Center"
                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,2,0,0"
                       Visibility="{Binding IsDataConnected, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Connection details, lower right. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,44"
                Background="#F7FBFF" BorderBrush="#C5D3E2" BorderThickness="1" CornerRadius="6"
                Padding="12,10" Width="288">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/status-device.png"
                           Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="Connection details" FontSize="10.5" FontWeight="Bold" Foreground="#1B2A55"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="live" FontSize="8" Foreground="#8A96A5" Margin="6,2,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x25BC;" FontSize="11" Foreground="#2E75B6" VerticalAlignment="Center" />
                        <TextBlock Text="Download" FontSize="9" Foreground="#5A6B7C" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DownloadRateValue}" FontSize="15" FontWeight="Bold" Foreground="#1B2A55" />
                        <TextBlock Text="{Binding DownloadRateUnit}" FontSize="8" Foreground="#5A6B7C"
                                   Margin="4,0,0,3" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x25B2;" FontSize="11" Foreground="#4C9A2A" VerticalAlignment="Center" />
                        <TextBlock Text="Upload" FontSize="9" Foreground="#5A6B7C" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UploadRateValue}" FontSize="15" FontWeight="Bold" Foreground="#1B2A55" />
                        <TextBlock Text="{Binding UploadRateUnit}" FontSize="8" Foreground="#5A6B7C"
                                   Margin="4,0,0,3" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Connection time" FontSize="9" Foreground="#6B7B8C" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SessionDurationText}" FontSize="10" VerticalAlignment="Center" Foreground="#1B2A55" />

                    <TextBlock Grid.Row="3" Text="Total traffic" FontSize="9" Foreground="#6B7B8C" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalTrafficText}" FontSize="10" VerticalAlignment="Center" Foreground="#1B2A55" />

                    <TextBlock Grid.Row="4" Text="This PC" FontSize="9" Foreground="#6B7B8C" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x25CF;" FontSize="9" Foreground="#2E75B6" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PcStatusText}" FontSize="10" FontWeight="Bold" Foreground="#1B2A55"
                                   Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
