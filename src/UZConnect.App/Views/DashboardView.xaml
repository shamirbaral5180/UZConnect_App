<UserControl x:Class="UZConnect.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d">
    <Grid Background="{StaticResource ContentBrush}" ClipToBounds="True">
        <!-- Faint globe watermark, matching the reference background. -->
        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/connection-watermark.png" Width="460" Height="460"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-140,0,0,-170"
               Stretch="Uniform" Opacity="0.7" IsHitTestVisible="False" />
        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/connection-watermark.png" Width="420" Height="420"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-120,0"
               Stretch="Uniform" Opacity="0.55" IsHitTestVisible="False" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,0">
            <Button Style="{StaticResource ConnectButton}" Command="{Binding ConnectCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/connect-icon.png" Width="24" Height="24" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ConnectButtonText}" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding ConnectionActionStatus}" HorizontalAlignment="Center" FontSize="10"
                       Foreground="{StaticResource MutedText}" Margin="0,10,0,0" MaxWidth="320"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ConnectionStatusText, StringFormat=Status: {0}}" HorizontalAlignment="Center"
                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding IpText, StringFormat=IP address: {0}}" HorizontalAlignment="Center"
                       FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,2,0,0"
                       Visibility="{Binding IsDataConnected, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Connected statistics, lower right, as in the reference. -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,58"
                    Visibility="{Binding IsDataConnected, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <TextBlock Text="Connection time:" FontSize="10" />
                <TextBlock Grid.Column="1" Text="{Binding SessionDurationText}" FontSize="10" />
                <TextBlock Grid.Row="1" Text="Downloaded:" FontSize="10" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DownloadTotalText}" FontSize="10" />
                <TextBlock Grid.Row="2" Text="Uploaded:" FontSize="10" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UploadTotalText}" FontSize="10" />
                <TextBlock Grid.Row="3" Text="Total:" FontSize="10" FontWeight="Bold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalTrafficText}" FontSize="10" FontWeight="Bold" />
                <TextBlock Grid.Row="4" Text="Downlink rate:" FontSize="10" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RxRateText}" FontSize="10" FontWeight="Bold" />
                <TextBlock Grid.Row="5" Text="Uplink rate:" FontSize="10" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TxRateText}" FontSize="10" FontWeight="Bold" />
            </Grid>
        </StackPanel>

        <!-- Disconnected activity, lower right, as in the reference. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,28,18"
                    Visibility="{Binding IsDataConnected, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="&#x25B2;" FontSize="16" Foreground="#D9534F" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TxRateText}" FontSize="10" Margin="5,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="&#x25BC;" FontSize="16" Foreground="#4C9A2A" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RxRateText}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>


