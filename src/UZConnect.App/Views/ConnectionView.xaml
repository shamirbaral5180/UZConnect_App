<UserControl x:Class="UZConnect.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionViewModel}"
             mc:Ignorable="d">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Mobile data" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource Badge}" HorizontalAlignment="Right"
                                        Background="{DynamicResource SuccessSoft}"
                                        Visibility="{Binding DataConnected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="CONNECTED" Style="{StaticResource PillText}"
                                               Foreground="{DynamicResource Success}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DataStatus}" Style="{StaticResource CardValue}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Change mobile data state"
                                    Command="{Binding ToggleMobileDataCommand}" Margin="0,16,0,0"
                                    HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding MobileDataNote}" Style="{StaticResource SubtleCaption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="Data session" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="APN" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding Apn}" Style="{StaticResource BodyText}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="IP address" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding IpAddress}" Style="{StaticResource MonoText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Download" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding RxBytes}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1">
                                    <TextBlock Text="Upload" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding TxBytes}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="{Binding UsageNote}" Style="{StaticResource SubtleCaption}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Automatically connect detected modem" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="App preference only; it does not alter firmware."
                                               Style="{StaticResource SubtleCaption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="APN records" Style="{StaticResource SectionTitle}" />
                            <Button Style="{StaticResource GhostButton}" Content="Refresh"
                                    Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Padding="10,5"
                                    FontSize="11" />
                        </Grid>
                        <TextBlock Text="{Binding ApnNote}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        <ItemsControl ItemsSource="{Binding Apns}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ApnRow}">
                                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoText}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Badge}"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="CURRENT" Style="{StaticResource PillText}" FontSize="9" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ApnEmptyText}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubtleCaption}" Margin="2,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Confirmation overlay -->
        <Grid Background="{DynamicResource Scrim}"
              Visibility="{Binding ShowConfirm, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="440" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Confirm connection change" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ConfirmText}" Style="{StaticResource Caption}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                                Command="{Binding CancelChangeCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Apply"
                                Command="{Binding ConfirmChangeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
