<UserControl x:Class="UZConnect.App.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MessagesViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Classic blue section header -->
        <Border Grid.Row="0" Background="#315E96" BorderBrush="#1F4E9A" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="{Binding FolderTitle, StringFormat=Text Message: {0}}" Foreground="White"
                           FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="8,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0"
                            VerticalAlignment="Center">
                    <CheckBox Content="Select all" Foreground="White" FontSize="10" VerticalAlignment="Center"
                              IsChecked="{Binding SelectAll, Mode=TwoWay}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CheckedCount, StringFormat={}{0} selected}" Foreground="White"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Find">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/dl-search.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="New text message"
                            Command="{Binding NewMessageCommand}">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/dl-compose.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Reply"
                            Command="{Binding ReplyCommand}">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/dl-reply.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Forward"
                            Command="{Binding ForwardCommand}">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/dl-forward.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Delete"
                            Command="{Binding RequestDeleteSelectedCommand}">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/dl-delete.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Export messages"
                            Command="{Binding ExportCommand}">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/dl-export.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Refresh"
                            Command="{Binding RefreshCommand}">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/tb-refresh.png" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Folder tree -->
            <Border Grid.Column="0" Background="#EEF4FA" BorderBrush="#A9B7C8" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Local" FontWeight="Bold" FontSize="12" Margin="8,8,8,4" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                             Style="{StaticResource ClassicListBox}" BorderThickness="0" Background="Transparent"
                             Margin="4,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SmsFolderItem}">
                                <StackPanel Margin="2,3" HorizontalAlignment="Center">
                                    <Image Source="{Binding IconPath}" Width="34" Height="34"
                                           HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                               Margin="0,1,0,0" />
                                    <TextBlock Text="{Binding UnreadText}" FontSize="10" FontWeight="Bold"
                                               Foreground="#C0392B" HorizontalAlignment="Center"
                                               Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="DataCard" FontWeight="Bold" FontSize="12" Margin="8,8"
                               Foreground="#66727F" />
                </Grid>
            </Border>

            <!-- Message table and details -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView x:Name="MessageList" Grid.Row="0" Style="{StaticResource ListViewStyle}"
                          ItemsSource="{Binding Messages}"
                          SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                          SelectionMode="Extended" Margin="4"
                          SelectionChanged="MessageList_SelectionChanged"
                          PreviewMouseLeftButtonUp="MessageList_PreviewMouseLeftButtonUp">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter Property="Background" Value="#EAF7DC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="28">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name/Number" Width="130"
                                            DisplayMemberBinding="{Binding Sender}" />
                            <GridViewColumn Header="Content" Width="430"
                                            DisplayMemberBinding="{Binding Preview}" />
                            <GridViewColumn Header="Date/Time" Width="130"
                                            DisplayMemberBinding="{Binding TimeDisplay}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border Grid.Row="1" Background="#F4F8FC" BorderBrush="#A9B7C8" BorderThickness="0,1,0,0"
                        Padding="8,6" Visibility="{Binding HasSelectedMessage, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name:" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding PreviewName}" FontSize="11" />
                        <TextBlock Grid.Row="1" Text="Number:" FontSize="11" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewNumber}" FontSize="11" />
                        <TextBlock Grid.Row="2" Text="Date:" FontSize="11" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewDateTime}" FontSize="11" />
                        <Button Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource ClassicButton}"
                                Content="Empty Recycle" Command="{Binding EmptyRecycleCommand}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsRecycleFolder, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#F4F8FC" BorderBrush="#A9B7C8" BorderThickness="0,1,0,0"
                        Padding="8,6" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding EmptyText}" FontSize="11" Foreground="{StaticResource MutedText}" />
                </Border>
            </Grid>
        </Grid>

        <!-- Classic compose dialog overlay -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="20" Background="#66000000"
              Visibility="{Binding IsComposing, Converter={StaticResource BoolToVis}}">
            <Border Width="440" Height="270" Background="#F0F4F8" BorderBrush="#1F4E9A" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource TitleBarBrush}">
                        <Grid>
                            <TextBlock Text="{Binding ComposeTitle}" Foreground="White" FontWeight="Bold" FontSize="11"
                                       Margin="8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource HeaderIconButton}" HorizontalAlignment="Right"
                                    Command="{Binding CancelComposeCommand}" ToolTip="Close">
                                <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/tb-close.png"
                                       Width="12" Height="12" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,3,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ClassicButton}" Content="Send to..." Click="SendToButton_Click" />
                            <TextBox Grid.Column="1" Style="{StaticResource ClassicTextBox}" Margin="4,0" Text="{Binding ComposeTo, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{Binding ComposeRecipientCountText}" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <TextBox Grid.Row="2" Style="{StaticResource ClassicMultilineTextBox}"
                                 Text="{Binding ComposeBody, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Grid.Row="3" Margin="0,4">
                            <TextBlock Text="{Binding ComposeCountText}" FontSize="10" Foreground="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding ComposeSegmentText}" FontSize="10" HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedText}" />
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SendStatus}" FontSize="10" Foreground="#B00020"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding HasSendStatus, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource ClassicButton}" Content="Send"
                                        Command="{Binding SendCommand}" Width="76" Margin="0,0,6,0" />
                                <Button Style="{StaticResource ClassicButton}" Content="Save"
                                        Command="{Binding SaveDraftCommand}" Width="76" Margin="0,0,6,0" />
                                <Button Style="{StaticResource ClassicButton}" Content="Exit"
                                        Command="{Binding CancelComposeCommand}" Width="76" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Delete confirmation -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="21" Background="#66000000"
              Visibility="{Binding ShowDeletePrompt, Converter={StaticResource BoolToVis}}">
            <Border Width="420" Background="#F0F4F8" BorderBrush="#1F4E9A" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="14">
                    <TextBlock Text="Delete message" FontWeight="Bold" FontSize="12" />
                    <TextBlock Text="{Binding DeletePromptText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="The message will be moved to Recycle." FontSize="10" Foreground="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource ClassicButton}" Content="Cancel"
                                Command="{Binding CancelDeleteCommand}" Width="76" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ClassicButton}" Content="Delete"
                                Command="{Binding ConfirmDeleteCommand}" Width="76" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SMS helper install prompt -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="22" Background="#66000000"
              Visibility="{Binding ShowAgentPrompt, Converter={StaticResource BoolToVis}}">
            <Border Width="460" Background="#F0F4F8" BorderBrush="#1F4E9A" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="14">
                    <TextBlock Text="SMS helper" FontWeight="Bold" FontSize="12" />
                    <TextBlock Text="Sending SMS requires a one-time helper app installed over ADB. It uses Android's own SMS service and has no UI or background polling."
                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource ClassicButton}" Content="Not now"
                                Command="{Binding CancelAgentPromptCommand}" Width="76" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ClassicButton}" Content="Install"
                                Command="{Binding ConfirmInstallAgentCommand}" Width="76" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>






