<UserControl x:Class="UZConnect.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SIGNAL STRENGTH" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding SignalDbm}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SignalLevelText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding SignalRaw, StringFormat=Source: {0}}"
                                       Style="{StaticResource SubtleCaption}" Margin="0,8,0,0" />
                            <Border Style="{StaticResource Divider}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Registration" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding Registration}" Style="{StaticResource BodyText}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Network type" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding NetworkType}" Style="{StaticResource BodyText}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,4,4">
                            <Border Width="12" Height="18" CornerRadius="4" Background="{DynamicResource Accent}"
                                    Margin="4,0" VerticalAlignment="Bottom"
                                    Opacity="{Binding SignalLevelOne, Converter={StaticResource BoolToOpacity}}" />
                            <Border Width="12" Height="30" CornerRadius="4" Background="{DynamicResource Accent}"
                                    Margin="4,0" VerticalAlignment="Bottom"
                                    Opacity="{Binding SignalLevelTwo, Converter={StaticResource BoolToOpacity}}" />
                            <Border Width="12" Height="42" CornerRadius="4" Background="{DynamicResource Accent}"
                                    Margin="4,0" VerticalAlignment="Bottom"
                                    Opacity="{Binding SignalLevelThree, Converter={StaticResource BoolToOpacity}}" />
                            <Border Width="12" Height="56" CornerRadius="4" Background="{DynamicResource Accent}"
                                    Margin="4,0" VerticalAlignment="Bottom"
                                    Opacity="{Binding SignalLevelFour, Converter={StaticResource BoolToOpacity}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Network registration" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Operator" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding Operator}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Data state" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding DataState}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="APN" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding Apn}" Style="{StaticResource BodyText}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="APN name" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding ApnName}" Style="{StaticResource BodyText}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="4">
                                <TextBlock Text="IP address" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding IpAddress}" Style="{StaticResource MonoText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <TextBlock Text="Country" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding Country}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Identity" Style="{StaticResource SectionTitle}" />
                            <Button Style="{StaticResource GhostButton}" Content="Refresh"
                                    Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Padding="10,5"
                                    FontSize="11" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SIM state" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding SimState}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Roaming" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding Roaming}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="IMEI" Style="{StaticResource CardLabel}" />
                                <TextBlock Text="{Binding ImeiDisplay}" Style="{StaticResource MonoText}"
                                           FontSize="13" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ImeiHint}" Style="{StaticResource SubtleCaption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Reveal"
                                    Command="{Binding ToggleImeiCommand}" Padding="10,5" FontSize="11"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="APN configuration" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Read-only. Editing is disabled until a write path is verified."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        <ItemsControl ItemsSource="{Binding Apns}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ApnRow}">
                                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoText}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="CURRENT" Style="{StaticResource PillText}" FontSize="9" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ApnEmptyText}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource FlatCard}" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Top" />
                    <TextBlock Text="Values are read from Android telephony and the modem's network registration. &quot;Not available&quot; means the firmware did not report a value; nothing is estimated except the signal-strength level, which is derived from dBm."
                               Style="{StaticResource Caption}" Margin="10,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubtleCaption}" Margin="2,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
