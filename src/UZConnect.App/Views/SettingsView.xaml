<UserControl x:Class="UZConnect.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             xmlns:views="clr-namespace:UZConnect.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Classic settings tree -->
        <Border Background="#EEF4FA" BorderBrush="#A9B7C8" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent" Margin="3,6">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsSection}">
                        <StackPanel Orientation="Horizontal" Margin="2,2">
                            <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/folder-small.png"
                                   Width="16" Height="16" Margin="1,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Column="1" Background="#EAF3FB" BorderBrush="#A9B7C8" BorderThickness="0,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="12,10,12,24">

                    <!-- General -->
                    <StackPanel Visibility="{Binding SelectedSectionKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=General}">
                        <TextBlock Text="Connect sound setting" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" />
                        <CheckBox Style="{StaticResource ClassicCheckBox}" Content="Prompt when connected"
                                  IsChecked="{Binding ConnectSoundPrompt, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource ClassicCheckBox}" Content="Prompt when disconnected"
                                  IsChecked="{Binding ConnectSoundDisconnect, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource ClassicCheckBox}" Content="Auto reconnect"
                                  IsChecked="{Binding AutoReconnect, Mode=TwoWay}" />
                        <TextBlock Text="Application" FontWeight="Bold" FontSize="11" Margin="0,14,0,4" />
                        <CheckBox Style="{StaticResource ClassicCheckBox}" Content="Close to the notification area"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource ClassicCheckBox}" Content="Start UZConnect with Windows"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="14,5,0,0" />
                        <CheckBox Style="{StaticResource ClassicCheckBox}" Content="Connect to the internet when UZConnect starts"
                                  IsChecked="{Binding ConnectOnStart, Mode=TwoWay}" Margin="14,5,0,0" />
                        <TextBlock Text="Closing the window keeps the modem connected in the notification area. Use Exit on the tray icon to quit."
                                   FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                        <TextBlock Text="These preferences are stored on this PC." FontSize="10"
                                   Foreground="{StaticResource MutedText}" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Text Message Setting, matching the D-Link dialog -->
                    <StackPanel Visibility="{Binding SelectedSectionKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=TextMessage}"
                                Width="600" HorizontalAlignment="Left">
                        <TextBlock Text="Text message handling" FontWeight="Bold" FontSize="11" />
                        <CheckBox Style="{StaticResource ClassicCheckBox}" Content="Prompt when receive new message"
                                  IsChecked="{Binding PromptNewMessage, Mode=TwoWay}" Margin="14,8,0,0" />
                        <TextBlock Text="Sound File Name:" FontSize="11" Margin="0,8,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource ClassicTextBox}" Height="23"
                                     Text="{Binding SoundFileName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource ClassicButton}" Content="Browser..."
                                    Command="{Binding BrowseSoundCommand}" Width="90" Height="23" Margin="4,0,0,0" />
                        </Grid>
                        <CheckBox Style="{StaticResource ClassicCheckBox}" Content="SMS Delivery Report"
                                  IsChecked="{Binding SmsDeliveryReport, Mode=TwoWay}" Margin="14,10,0,0" />

                        <Border Height="1" Background="#C5D3E2" Margin="0,16,0,12" />

                        <TextBlock Text="New Message Save Mode" FontWeight="Bold" FontSize="11" />
                        <RadioButton Content="Save in local" GroupName="SaveMode" FontSize="11"
                                     IsChecked="{Binding SaveMessagesLocal, Mode=TwoWay}" Margin="14,8,0,0" />
                        <RadioButton Content="Save on (U)SIM" GroupName="SaveMode" FontSize="11"
                                     IsChecked="{Binding SaveMessagesOnSim, Mode=TwoWay}" Margin="14,5,0,0" />
                    </StackPanel>

                    <!-- Profile Management, matching the D-Link dialog -->
                    <Grid Visibility="{Binding SelectedSectionKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Profiles}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Border Background="#F0F4F8" BorderBrush="#A9B7C8" BorderThickness="1,1,1,0"
                                    CornerRadius="4,4,0,0" Padding="10,3" HorizontalAlignment="Left">
                                <TextBlock Text="Connection configuration" FontSize="11" />
                            </Border>
                            <Border Background="#F0F4F8" BorderBrush="#A9B7C8" BorderThickness="1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Profile Name" FontSize="11" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Height="23" Margin="0,4,0,8" IsEditable="True"
                                              ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                              Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="ProfileSelection_Changed" />

                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Parameter" FontWeight="Bold"
                                               FontSize="11" Margin="0,4,0,4" />

                                    <TextBlock Grid.Row="2" Text="APN:" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ClassicTextBox}"
                                             Height="23" Margin="0,4,0,8"
                                             Text="{Binding ProfileApn, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="3" Text="Access number:" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ClassicTextBox}"
                                             Height="23" Margin="0,4,0,8"
                                             Text="{Binding ProfileAccessNumber, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="4" Text="User name:" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ClassicTextBox}"
                                             Height="23" Margin="0,4,0,8"
                                             Text="{Binding ProfileUser, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="5" Text="Password:" FontSize="11" VerticalAlignment="Center" />
                                    <PasswordBox Grid.Row="5" Grid.Column="1" MinHeight="23" Margin="0,4,0,8"
                                                 PasswordChanged="ProfilePassword_Changed" />

                                    <TextBlock Grid.Row="6" Text="Authentication type:" FontSize="11" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="6" Grid.Column="1" Height="23" Margin="0,4,0,0"
                                              SelectedValue="{Binding ProfileAuthType, Mode=TwoWay}"
                                              SelectedValuePath="Content">
                                        <ComboBoxItem Content="None" />
                                        <ComboBoxItem Content="PAP" />
                                        <ComboBoxItem Content="CHAP" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button Style="{StaticResource ClassicButton}" Content="New" Height="28"
                                    Command="{Binding NewProfileCommand}" Margin="0,10,0,4" />
                            <Button Style="{StaticResource ClassicButton}" Content="Delete" Height="28"
                                    Command="{Binding DeleteProfileCommand}" Margin="0,4" />
                            <Button Style="{StaticResource ClassicButton}" Content="Edit" Height="28"
                                    Command="{Binding EditProfileCommand}" Margin="0,4" />
                            <Button Style="{StaticResource ClassicButton}" Content="Save" Height="28"
                                    Command="{Binding SaveProfileCommand}" Margin="0,4" />
                            <Button Style="{StaticResource ClassicButton}" Content="Undo" Height="28"
                                    Command="{Binding UndoProfileCommand}" Margin="0,4" />
                            <Button Style="{StaticResource ClassicButton}" Content="Set as default" Height="28"
                                    Command="{Binding SetDefaultProfileCommand}" Margin="0,4" />
                            <Button Style="{StaticResource ClassicButton}" Content="Import" Height="28"
                                    Command="{Binding ImportProfilesCommand}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Network -->
                    <StackPanel Visibility="{Binding SelectedSectionKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Network}">
                        <TextBlock Text="Network" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" />
                        <TextBlock Text="Network mode" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox Width="140" Height="24" SelectedValue="{Binding NetworkMode, Mode=TwoWay}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="3G only" />
                                <ComboBoxItem Content="4G only" />
                            </ComboBox>
                            <Button Style="{StaticResource ClassicButton}" Content="Apply" Width="80" Margin="8,0,0,0"
                                    Command="{Binding ApplyNetworkModeCommand}" />
                        </StackPanel>
                        <TextBlock Text="Use Profile Management to configure the APN used for mobile data."
                                   FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Statistics -->
                    <StackPanel Visibility="{Binding SelectedSectionKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Statistics}">
                        <TextBlock Text="Statistics" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" />
                        <TextBlock Text="Traffic statistics are read from the modem while it is connected. Transfer counters are reset by the modem."
                                   FontSize="11" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Diagnostics -->
                    <StackPanel Visibility="{Binding SelectedSectionKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Diagnostics}">
                        <TextBlock Text="Diagnostics" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" />
                        <TextBox Style="{StaticResource ClassicMultilineTextBox}" IsReadOnly="True" Height="150"
                                 Width="520" HorizontalAlignment="Left" Text="{Binding DiagnosticsText, Mode=OneWay}" />
                        <TextBlock Text="Run Refresh to update the device, SIM and network status."
                                   FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Connection Type, matching the D-Link dialog -->
                    <StackPanel Visibility="{Binding SelectedSectionKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=ConnectionType}"
                                Width="420" HorizontalAlignment="Left">
                        <TextBlock Text="Connection Type:" FontWeight="Bold" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="18,14,0,0">
                            <RadioButton Content="RAS" GroupName="ConnectionType" FontSize="11"
                                         IsChecked="{Binding ConnectionTypeRas, Mode=TwoWay}" />
                            <RadioButton Content="NDIS" GroupName="ConnectionType" FontSize="11" Margin="24,0,0,0"
                                         IsChecked="{Binding ConnectionTypeNdis, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Wi-Fi Management (the only additional section) -->
                    <Grid Visibility="{Binding SelectedSectionKey, Converter={StaticResource StringEqualsToVis}, ConverterParameter=WiFi}">
                        <views:WifiManagementView DataContext="{Binding Wifi}" />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.ColumnSpan="2" Text="{Binding StatusText}" FontSize="10" Foreground="{StaticResource MutedText}"
                   VerticalAlignment="Bottom" Margin="198,0,8,3" />
    </Grid>
</UserControl>
