<UserControl x:Class="UZConnect.App.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UZConnect.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ContactsViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#315E96" BorderBrush="#1F4E9A" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Contacts: DataCard" Foreground="White" FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Find">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/tb-find.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="New contact" IsEnabled="False">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/tb-new.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Edit contact" IsEnabled="False">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/folder-draft.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Delete contact" IsEnabled="False">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/tb-delete.png" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource HeaderIconButton}" ToolTip="Refresh"
                            Command="{Binding RefreshCommand}">
                        <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/tb-refresh.png" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#EEF4FA" BorderBrush="#A9B7C8" BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock Text="Local" FontSize="11" Margin="8,10" Foreground="#66727F" />
                    <Border Background="#D6E6F5" BorderBrush="#8AA7C4" BorderThickness="1" Margin="6,4"
                            Padding="8,8">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/UZConnect;component/Assets/icons/contact-sim.png"
                                   Width="36" Height="36" HorizontalAlignment="Center" />
                            <TextBlock Text="DataCard" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ContactCount, StringFormat={}{0} contact(s)}" FontSize="10"
                               Foreground="{StaticResource MutedText}" Margin="10,10,8,0" />
                    <TextBlock Text="Read-only SIM phonebook." FontSize="10" Foreground="{StaticResource MutedText}"
                               Margin="10,4,8,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView Style="{StaticResource ListViewStyle}" ItemsSource="{Binding Contacts}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Mobile" Width="200" DisplayMemberBinding="{Binding Number}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Border Grid.Row="1" Background="#F4F8FC" BorderBrush="#A9B7C8" BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <TextBlock Text="{Binding EmptyText}" FontSize="10" Foreground="{StaticResource MutedText}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

