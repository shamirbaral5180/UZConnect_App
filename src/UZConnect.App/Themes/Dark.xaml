<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#15171A</Color>
    <Color x:Key="SidebarBackgroundColor">#1B1E22</Color>
    <Color x:Key="SurfaceColor">#21252A</Color>
    <Color x:Key="SurfaceAltColor">#1A1D21</Color>
    <Color x:Key="SurfaceHoverColor">#2A2F36</Color>
    <Color x:Key="BorderColor">#30353C</Color>
    <Color x:Key="BorderStrongColor">#3F4650</Color>
    <Color x:Key="TextPrimaryColor">#F1F4F8</Color>
    <Color x:Key="TextSecondaryColor">#A7AFBA</Color>
    <Color x:Key="TextTertiaryColor">#77808C</Color>
    <Color x:Key="AccentColor">#4B9EF7</Color>
    <Color x:Key="AccentHoverColor">#6FB3FA</Color>
    <Color x:Key="AccentSoftColor">#1B3550</Color>
    <Color x:Key="AccentForegroundColor">#06131F</Color>
    <Color x:Key="SuccessColor">#55D36A</Color>
    <Color x:Key="SuccessSoftColor">#17351D</Color>
    <Color x:Key="WarningColor">#F3C64B</Color>
    <Color x:Key="WarningSoftColor">#3A2E11</Color>
    <Color x:Key="DangerColor">#FF7468</Color>
    <Color x:Key="DangerSoftColor">#3E1B1B</Color>
    <Color x:Key="GradientStartColor">#123A5E</Color>
    <Color x:Key="GradientEndColor">#0C4B50</Color>
    <Color x:Key="ScrimColor">#99000000</Color>

    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentForeground" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoft" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoft" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="Scrim" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#4A525D" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#626C79" />
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource GradientEndColor}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
