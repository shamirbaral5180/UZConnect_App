<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#F2F4F7</Color>
    <Color x:Key="SidebarBackgroundColor">#E9EDF2</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F7F9FC</Color>
    <Color x:Key="SurfaceHoverColor">#EEF2F7</Color>
    <Color x:Key="BorderColor">#DFE4EB</Color>
    <Color x:Key="BorderStrongColor">#CBD2DC</Color>
    <Color x:Key="TextPrimaryColor">#171A1F</Color>
    <Color x:Key="TextSecondaryColor">#5B6470</Color>
    <Color x:Key="TextTertiaryColor">#87909C</Color>
    <Color x:Key="AccentColor">#0F6CBD</Color>
    <Color x:Key="AccentHoverColor">#0C5AA0</Color>
    <Color x:Key="AccentSoftColor">#E5F0FB</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#107C10</Color>
    <Color x:Key="SuccessSoftColor">#DDF6DC</Color>
    <Color x:Key="WarningColor">#9A6700</Color>
    <Color x:Key="WarningSoftColor">#FFF3CE</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>
    <Color x:Key="DangerSoftColor">#FDE8E8</Color>
    <Color x:Key="GradientStartColor">#0A4F91</Color>
    <Color x:Key="GradientEndColor">#0C6B70</Color>
    <Color x:Key="ScrimColor">#66101418</Color>

    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentForeground" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoft" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoft" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="Scrim" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#B8C0CB" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#98A3B1" />
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource GradientEndColor}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
