<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UZConnect.Windows</RootNamespace>
    <AssemblyName>UZConnect.Windows</AssemblyName>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UZConnect.Core\UZConnect.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Helpers are embedded so the single-file build works without an Assets folder. -->
    <EmbeddedResource Include="..\..\tools\agent\out\uzconnect-agent.apk" Link="Helpers\uzconnect-agent.apk"
                      LogicalName="UZConnect.Helpers.uzconnect-agent.apk"
                      Condition="Exists('..\..\tools\agent\out\uzconnect-agent.apk')" />
    <EmbeddedResource Include="..\..\tools\wifi\out\uzconnect-wifi.jar" Link="Helpers\uzconnect-wifi.jar"
                      LogicalName="UZConnect.Helpers.uzconnect-wifi.jar"
                      Condition="Exists('..\..\tools\wifi\out\uzconnect-wifi.jar')" />
  </ItemGroup>
</Project>
